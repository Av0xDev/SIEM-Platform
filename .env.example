# SIEM Platform - Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Frontend Configuration
# ============================================================================
REACT_APP_API_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# ============================================================================
# Python Backend Configuration (Flask)
# ============================================================================
# Environment: development, production, testing
FLASK_ENV=development

# Database connections
DATABASE_URL=mongodb://localhost:27017/siem
POSTGRES_URL=******localhost:5432/siem

# Security
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO

# ============================================================================
# Java Backend Configuration (Spring Boot)
# ============================================================================
# Server port
SERVER_PORT=8080

# MongoDB Configuration
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/siem
SPRING_DATA_MONGODB_DATABASE=siem

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/siem
SPRING_DATASOURCE_USERNAME=siem
SPRING_DATASOURCE_PASSWORD=siem_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate Configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Security
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=86400000

# Swagger/API Documentation
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

# ============================================================================
# Ruby Backend Configuration (Sinatra)
# ============================================================================
# Environment: development, production, test
RACK_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=******localhost:5432/siem_ruby

# ============================================================================
# PHP Backend Configuration
# ============================================================================
# Environment: development, production
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=siem
DB_PASS=siem_password
DB_NAME=siem_php

# PHP Settings
PHP_MEMORY_LIMIT=128M
PHP_MAX_EXECUTION_TIME=30
PHP_POST_MAX_SIZE=100M

# ============================================================================
# Database Configuration
# ============================================================================
# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=siem
MONGODB_USERNAME=
MONGODB_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=siem
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_password

# ============================================================================
# Logging and Monitoring
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# Application Security
# ============================================================================
# Change these values in production!
JWT_SECRET=change-me-in-production
API_SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=change-me-in-production

# ============================================================================
# External Services (if applicable)
# ============================================================================
# Threat Intelligence APIs
THREAT_INTEL_API_KEY=your-api-key-here
THREAT_INTEL_API_URL=https://api.example.com

# Notification Services
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SERVICE_URL=smtp://mail.example.com
EMAIL_FROM=noreply@siem-platform.local

# ============================================================================
# Docker Configuration (if using Docker Compose)
# ============================================================================
COMPOSE_PROJECT_NAME=siem-platform
DOCKER_NETWORK=siem-network

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug logging
DEBUG=false

# CORS settings
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
