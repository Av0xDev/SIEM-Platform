# PostgreSQL
POSTGRES_DB=siem
POSTGRES_USER=siem
POSTGRES_PASSWORD=changeme

# MongoDB
MONGO_USER=siem
MONGO_PASSWORD=changeme
MONGO_DB=siem_logs
MONGO_URI=mongodb://siem:changeme@mongodb:27017/siem_logs?authSource=admin

# Redis
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# Python/Flask
FLASK_ENV=production
DB_HOST=postgres
DB_PORT=5432
SECRET_KEY=changeme-secret-key
JWT_SECRET=changeme-jwt-secret

# Java/Spring
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/siem

# PHP
PYTHON_SERVICE_URL=http://backend-python:5000
WEBHOOK_SECRET=changeme-webhook-secret
PHP_DISPLAY_ERRORS=0

# Ruby
JAVA_SERVICE_URL=http://backend-java:8080
SCHEDULER_INTERVAL=60
