# ============================================================
# SIEM Platform - Java Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to source control
# ============================================================

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/siem_db
DB_USERNAME=siem_user
DB_PASSWORD=change_me_strong_password

# ---- JWT Security ----
# Generate a secure 256-bit base64-encoded secret:
#   openssl rand -base64 32
JWT_SECRET=change_me_base64_encoded_256bit_secret_key_here_minimum_32_chars
JWT_EXPIRATION=86400000       # 24 hours in milliseconds
JWT_REFRESH_EXPIRATION=604800000  # 7 days in milliseconds

# ---- Server ----
SERVER_PORT=8080

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- Logging ----
# Options: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_SIEM=INFO
LOG_LEVEL_SECURITY=WARN
