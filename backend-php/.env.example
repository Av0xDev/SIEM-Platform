# PHP Webhook Service — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ----- Application -----
APP_ENV=production
BASE_PATH=
LOG_FILE=/var/log/siem-php/webhook.log
LOG_LEVEL=warning

# ----- Database (PostgreSQL) -----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=siem_db
DB_USER=siem_user
DB_PASSWORD=CHANGE_ME

# ----- Downstream Services -----
PYTHON_SERVICE_URL=http://python-service:5000
JAVA_SERVICE_URL=http://java-service:8080
RUBY_SERVICE_URL=http://ruby-service:3000

# ----- Security -----
# HMAC-SHA256 secret used to verify incoming webhook signatures
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Bearer token for internal service-to-service calls
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JWT settings
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256

# ----- Rate Limiting -----
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ----- CORS -----
ALLOWED_ORIGINS=*
