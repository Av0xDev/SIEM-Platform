{
    "name": "siem/php-webhook-service",
    "description": "SIEM Platform PHP Webhook Receiver Service",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.8",
        "firebase/php-jwt": "^6.10",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SIEM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SIEM\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox tests/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
