# Ruby Automation Engine — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.

# ----- Application -----
APP_ENV=production
PORT=3000
LOG_LEVEL=info

# ----- Downstream Services -----
PYTHON_SERVICE_URL=http://python-service:5000
JAVA_SERVICE_URL=http://java-service:8080
PHP_SERVICE_URL=http://php-service:8000

# ----- Security -----
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://siem_user:CHANGE_ME@postgres:5432/siem_db

# ----- MongoDB -----
MONGODB_URI=mongodb://siem_user:CHANGE_ME@mongo:27017/siem_db

# ----- Scheduler -----
INCIDENT_MAX_AGE_DAYS=90

# ----- CORS -----
ALLOWED_ORIGINS=*
